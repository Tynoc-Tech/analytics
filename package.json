{
  "name": "@tynoc/analytics",
  "version": "0.1.0",
  "description": "Privacy-friendly Web Analytics for sites deployed on Tynoc. No cookies, no personal data.",
  "license": "MIT",
  "author": "Tynoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tynoc-Tech/analytics.git"
  },
  "homepage": "https://github.com/Tynoc-Tech/analytics#readme",
  "bugs": {
    "url": "https://github.com/Tynoc-Tech/analytics/issues"
  },
  "keywords": [
    "tynoc",
    "analytics",
    "web-analytics",
    "privacy",
    "nextjs",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./script.js": "./dist/script.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "next": [
        "./dist/next.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
